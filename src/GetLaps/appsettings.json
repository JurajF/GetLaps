{
  // Fill these in with your Entra app registration, or better, supply them as
  // environment variables (AzureAd__TenantId, AzureAd__ClientId, AzureAd__ClientSecret).
  // Never commit a real client secret to this file.
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "",
    "ClientId": "",
    "ClientSecret": "",
    "CallbackPath": "/signin-oidc",
    "SignedOutCallbackPath": "/signout-callback-oidc"
  },
  "Graph": {
    "BaseUrl": "https://graph.microsoft.com/v1.0/",
    "BetaBaseUrl": "https://graph.microsoft.com/beta/"
  },
  // Set ReverseProxy:Enabled to true when the container runs behind a TLS-terminating
  // proxy (App Service, Container Apps, nginx, Traefik...) so redirect URIs use https.
  "ReverseProxy": {
    "Enabled": false
  },
  // Optional: folder for ASP.NET Core data protection keys (mount a volume here in Docker
  // so sign-in cookies survive container restarts).
  "DataProtection": {
    "KeysPath": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
